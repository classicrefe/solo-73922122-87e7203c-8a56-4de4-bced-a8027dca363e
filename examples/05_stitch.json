{
  "name": "05 拼稿 · 三段合稿与标签合并",
  "description": "对应网页「拼稿」标签页的『填入拼稿示例』按钮：先创建并确认下面三个会话，再按阅读顺序拼合，接缝候选分别给 [1,2,3] 与 [1,2]。",
  "segments": [
    {
      "original": "甲乙丙丁戊",
      "revised": "甲乙丙丁戊",
      "labels": { "labels": [{ "id": "L1", "start": 3, "end": 5 }] },
      "expect": "标签 L1 覆盖末尾“丁戊”"
    },
    {
      "original": "丁戊己庚",
      "revised": "丁戊己庚",
      "labels": { "labels": [
        { "id": "L1", "start": 0, "end": 2 },
        { "id": "L2", "start": 2, "end": 4 }
      ] },
      "expect": "L1=“丁戊” 与第 1 段标签在合稿中完全重合并合并；L2=“己庚”"
    },
    {
      "original": "己庚辛壬",
      "revised": "己庚辛壬",
      "labels": { "labels": [{ "id": "L9", "start": 0, "end": 2 }] },
      "expect": "L9=“己庚” 与第 2 段 L2 完全重合并合并"
    }
  ],
  "seams": [{ "candidates": [1, 2, 3] }, { "candidates": [1, 2] }],
  "expect": {
    "legal_overlaps": [2, 2],
    "merged": "甲乙丙丁戊己庚辛壬",
    "merged_length": 9,
    "rejected_candidates": "接缝1 的 1/3、接缝2 的 1 因前后码点不一致被拒",
    "merged_labels": "M1[3,5)“丁戊”来源=段1·L1+段2·L1；M2[5,7)“己庚”来源=段2·L2+段3·L9"
  }
}
